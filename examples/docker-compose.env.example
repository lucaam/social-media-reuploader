# Copia questo file in `.env` accanto a docker-compose.yml e compilalo.
# Non committare MAI il file .env (contiene il token del bot).
#
#   cp examples/docker-compose.env.example .env

# --- Obbligatori -------------------------------------------------------------
# Token del bot ottenuto da @BotFather.
BOT_TOKEN=
# Chiave che firma i cookie di sessione della GUI (almeno 32 caratteri casuali):
#   openssl rand -hex 32
SECRET_KEY=
# Token per il login nella GUI (serve se non configuri OAuth):
#   openssl rand -hex 24
ADMIN_TOKEN=

# --- Facoltativi (tabella completa nel README) -------------------------------
# MODE=polling
# LOG_LEVEL=INFO
# WORKERS=2
# MAX_PENDING_PER_CHAT=3
# RATE_LIMITS=1/10,3/60,5/3600,20/30d
# DUPLICATE_WINDOW_SECONDS=5400
# ALLOWED_PROVIDERS=youtube,tiktok,instagram
# BLOCKED_PROVIDERS=
# UNSUPPORTED_LINK_REPLY=private
# YTDLP_COOKIES_PATH=/run/secrets/cookies.txt

# Indirizzo su cui pubblicare le porte 8080 (bot) e 8081 (GUI).
# BIND_ADDRESS=127.0.0.1

# GUI servita in HTTPS dietro un reverse proxy:
# SESSION_COOKIE_SECURE=true
# OAUTH_REDIRECT_URI=https://admin.example.com/auth
# OAUTH_SERVER_METADATA_URL=https://idp.example.com/.well-known/openid-configuration
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ADMIN_GROUPS=admins
